# Replit Database injects this value in development and production.
DATABASE_URL=

# Create the first owner with `npm run db:seed`.
ADMIN_BOOTSTRAP_EMAIL=
# Frase única de al menos 16 caracteres. Elimina este Secret después del seed.
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrador Intervo

# At least 32 random characters, unique per environment. Protects sessions and CSRF tokens.
SESSION_SECRET=

# Replit App Storage. The SDK can discover the attached bucket in Replit.
REPLIT_OBJECT_STORAGE_BUCKET_ID=

# Optional notifications and translation assistance.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=agarcia@intervo.legal
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5-mini

# Canonical URL of the full-stack deployment.
NEXT_PUBLIC_SITE_URL=https://intervo-page-2026.replit.app
