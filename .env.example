# Replit Database injects this value in development and production.
DATABASE_URL=

# Create the first owner with `npm run db:seed`.
ADMIN_BOOTSTRAP_EMAIL=
# Frase única de al menos 16 caracteres. Elimina este Secret después del seed.
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrador Intervo

# At least 32 random characters, unique per environment. Protects sessions and CSRF tokens.
SESSION_SECRET=

# Replit App Storage Configuration. Leave empty when this app has a single
# attached bucket; set the Bucket ID only when selecting among multiple buckets.
REPLIT_OBJECT_STORAGE_BUCKET_ID=

# Optional notifications and translation assistance.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=info@intervo.legal
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5-mini

# Canonical URL assigned to this Replit account. Replit is detected
# automatically at runtime, but set this before the final production build.
NEXT_PUBLIC_SITE_URL=

# Temporary handoff-only connection strings. Never commit their values and
# delete them from Replit Secrets after the private bundle is transferred.
HANDOFF_SOURCE_DATABASE_URL=
HANDOFF_TARGET_DATABASE_URL=
