{
  "name": "intervo-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web corporativo bilingüe de intervø — Legal and Business Consulting (Intervo Legal, S.C.)",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "npm run clean:appledouble && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean:appledouble": "find . -name '._*' -not -path './node_modules/*' -delete",
    "db:generate": "npm run clean:appledouble && drizzle-kit generate",
    "db:migrate": "npm run clean:appledouble && drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed-cms.ts",
    "cms:apply-client-feedback": "tsx scripts/apply-client-feedback-2026-08.ts",
    "test": "npm run test:cms && npm run test:auth && npm run test:media",
    "test:cms": "node --import tsx --test src/lib/cms/*.test.ts",
    "test:auth": "node --import tsx --test src/lib/auth/*.test.ts",
    "test:media": "node --import tsx --test src/lib/media/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@replit/object-storage": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "^6.18.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.2",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "minimatch": "10.2.6",
    "postcss": "$postcss",
    "sharp": "$sharp",
    "uuid": "11.1.1"
  }
}
